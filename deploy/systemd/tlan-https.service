[Unit]
Description=TLAN Caddy HTTPS Gateway
After=network-online.target tlan.service
Wants=network-online.target tlan.service

[Service]
Type=simple
User=tlanhttps
Group=tlanhttps
WorkingDirectory=/var/lib/tlan-caddy
Environment=HOME=/var/lib/tlan-caddy
Environment=XDG_DATA_HOME=/var/lib/tlan-caddy/.local/share
Environment=XDG_CONFIG_HOME=/var/lib/tlan-caddy/.config
ExecStart=/opt/tlan/caddy run --config /opt/tlan/Caddyfile --adapter caddyfile
ExecReload=/opt/tlan/caddy reload --config /opt/tlan/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
